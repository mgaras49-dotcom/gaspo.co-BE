# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Frontend URL used for post-OAuth redirect and CORS origin
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gomer
DATABASE_USER=postgres
DATABASE_PASSWORD=password

DATABASE_URL=postgresql://postgres:password@localhost:5432/gomer

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Slack OAuth
# ─────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback
# Comma-separated OAuth scopes requested from Slack
SLACK_SCOPES=chat:write,users:read,users:read.email,team:read

# ─────────────────────────────────────────────
# Pipedream Connect (managed integrations)
# ─────────────────────────────────────────────
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
# development | production
PIPEDREAM_ENVIRONMENT=development

# ─────────────────────────────────────────────
# Meta Ads (native — Meta hosted MCP via Business OAuth)
# ─────────────────────────────────────────────
META_MCP_URL=https://mcp.facebook.com/ads
# Optional: leave blank to self-register via Dynamic Client Registration
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:3000/integrations/meta/callback
# Space-separated ad scopes
META_SCOPES=ads_management ads_read business_management
# Facebook Login for Business configuration id (Meta app -> Facebook Login for
# Business -> Configurations). That product carries its permissions in the
# configuration, so when this is set the consent URL sends config_id and drops
# META_SCOPES. Leave empty only for an app on classic Facebook Login — sending
# scope to a business-login app fails with "App not active".
META_LOGIN_CONFIG_ID=

# ─────────────────────────────────────────────
# AI (Anthropic Claude)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Fallback model when a workspace has not chosen one in Settings.
# One of: claude-sonnet-5 (default), claude-opus-4-8.
AI_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────
# AI gateway (optional) — non-Anthropic models
# ─────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Leave blank to run Anthropic-only.
#   OpenRouter (hosted, nothing to operate): https://openrouter.ai/api/v1
#   Self-hosted OmniRoute:                   http://<host>:20128/v1
#   OpenAI direct:                           https://api.openai.com/v1
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Which models the gateway serves, as a JSON array. Ids must match the
# gateway's own naming exactly, and prices are per million tokens in USD —
# they set what workspaces are charged, so copy them from the gateway's
# pricing page rather than guessing.
#
# supportsTools MUST be true for a model to be selectable: Gaspo drives
# everything through tool calls, so a model that ignores them fails every
# request. Verify with a real tool-calling test before listing one — many
# cheap models advertise support and then ignore the tools.
#
# AI_GATEWAY_MODELS=[{"id":"openai/gpt-5.1","name":"GPT-5.1","description":"OpenAI's frontier model.","inputPricePerMillion":1.25,"outputPricePerMillion":10,"supportsTools":true}]
AI_GATEWAY_MODELS=

# ─────────────────────────────────────────────
# Image generation (optional)
# ─────────────────────────────────────────────
# Set one key and Gaspo can make images in chat; with neither it says it
# cannot. Gemini ("Nano Banana", key from aistudio.google.com) wins when both
# are set. Each image is charged to the workspace at the provider's list price.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Public base URL of this API, for links to files Gaspo makes (PDFs, images).
# Defaults to FRONTEND_URL + /api, which is right in production. Locally set it
# to the ngrok tunnel so Slack can load the images.
# PUBLIC_API_URL=https://<your-tunnel>.ngrok-free.app

# ─────────────────────────────────────────────
# Super admin (platform owner)
# ─────────────────────────────────────────────
# Comma-separated emails allowed into /super-admin, the cross-tenant owner
# panel. These addresses read every workspace's customers, revenue and usage,
# so keep the list to the people who already own that data.
#
# Matched case-insensitively against the email Slack reports for the signed-in
# user. Leave blank — the default — and the panel is unreachable for everyone,
# which is what every deployment except the owner's should do.
SUPER_ADMIN_EMAILS=
